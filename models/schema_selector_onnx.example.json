{
  "model_type": "onnx_score_ranker",
  "source_model": "models/schema_selector.onnx",
  "training_formulation": "score_prediction_ranking",
  "input_name": "features",
  "output_name": "score",
  "execution_provider": "cpu",
  "device_id": 0,
  "feature_names": [
    "num_points",
    "feature_sample_size",
    "bbox_x",
    "bbox_y",
    "bbox_z",
    "aspect_xy",
    "aspect_xz",
    "aspect_yz",
    "density_bbox",
    "height_mean",
    "height_std",
    "height_range",
    "cov_eig_0",
    "cov_eig_1",
    "cov_eig_2",
    "linearity",
    "planarity",
    "scattering",
    "occupancy_ratio_8",
    "occupancy_entropy_8",
    "density_cv_8",
    "verticality_score",
    "flatness_score",
    "w_range",
    "w_radius",
    "w_knn",
    "knn_k",
    "num_queries",
    "query_scale_mean",
    "query_scale_std",
    "build_weight",
    "memory_weight",
    "schema_has_quadtree",
    "schema_has_octree",
    "schema_has_kdtree",
    "schema_has_grid2d",
    "schema_has_grid3d",
    "schema_num_blocks",
    "schema_total_levels",
    "schema_max_leaf_capacity",
    "schema_min_leaf_capacity"
  ],
  "candidate_schemas": [
    { "name": "quadtree_default", "path": "configs/schemas/quadtree.json" },
    { "name": "octree_default", "path": "configs/schemas/octree.json" },
    { "name": "kdtree_default", "path": "configs/schemas/kdtree.json" },
    { "name": "quadtree_octree", "path": "configs/schemas/quadtree_octree.json" },
    { "name": "octree_kdtree", "path": "configs/schemas/octree_kdtree.json" },
    { "name": "urban_hybrid_quadtree_octree_kdtree", "path": "configs/schemas/urban_hybrid.json" }
  ]
}
